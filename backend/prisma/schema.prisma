// Jewar Property Hub — Prisma schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OWNER
}

enum PropertyType {
  PLOT
  HOUSE
  FLAT
  SHOP
  OFFICE
  COMMERCIAL
  AGRICULTURAL_LAND
  FARMHOUSE
  INDUSTRIAL
  BUILDING
  OTHER
}

enum PropertyPurpose {
  SALE
  RENT
  LEASE
}

enum AreaUnit {
  GAJ // sq yd
  SQFT
  SQM
  ACRE
  HECTARE
  BIGHA
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  PENDING
  UNDER_DISCUSSION
  SOLD
  RENTED
  LEASED
  HIDDEN
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  CONTACT_VERIFIED
  DETAILS_VERIFIED
  DOCUMENTS_PENDING
  VERIFIED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  SITE_VISIT_PLANNED
  NEGOTIATION
  CLOSED
  NOT_INTERESTED
}

enum SubmissionStatus {
  PENDING_REVIEW
  CONTACTED
  CONVERTED
  REJECTED
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  role         Role      @default(OWNER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownerProfile Owner?
}

model Owner {
  id                 String     @id @default(cuid())
  fullName           String
  phone              String
  alternatePhone     String?
  whatsapp           String?
  email              String?
  preferredContact    String?   // phone | whatsapp | email
  privateNotes       String?    @db.Text // NEVER exposed publicly
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Optional self-service login — set when the owner signs up and is
  // matched/linked to this record (by phone). Not every Owner has a login.
  userId             String?    @unique
  user               User?      @relation(fields: [userId], references: [id])

  properties         Property[]

  @@index([phone])
}

model Property {
  id                  String              @id @default(cuid())
  propertyCode        String              @unique // e.g. JPH-00001
  slug                String              @unique

  title               String
  propertyType        PropertyType
  purpose             PropertyPurpose
  status              PropertyStatus      @default(DRAFT)
  verification         VerificationStatus  @default(UNVERIFIED)
  featured            Boolean             @default(false)

  // PUBLIC pricing
  publicPrice         Decimal?            @db.Decimal(14, 2)
  priceOnRequest       Boolean             @default(false)
  negotiable           Boolean             @default(false)

  // Area
  areaValue           Decimal             @db.Decimal(12, 2)
  areaUnit             AreaUnit
  lengthFt            Decimal?            @db.Decimal(10, 2)
  widthFt             Decimal?            @db.Decimal(10, 2)

  // Location (public-safe)
  address             String?
  locality            String?
  city                String              @default("Jewar")
  district            String              @default("Gautam Buddh Nagar")
  state               String              @default("Uttar Pradesh")
  pincode             String?
  landmark            String?
  latitude            Decimal?            @db.Decimal(10, 6)
  longitude           Decimal?            @db.Decimal(10, 6)

  // Free-form specification bag, shape depends on propertyType
  // e.g. { bedrooms, bathrooms, floor, totalFloors, facing, roadWidthFt, furnishing, parking, corner, societyName, ... }
  specifications      Json?

  description         String?             @db.Text

  // SEO
  seoTitle            String?
  metaDescription      String?

  // PRIVATE deal information — never returned by public endpoints
  ownerAskingPrice     Decimal?            @db.Decimal(14, 2)
  minExpectedPrice     Decimal?            @db.Decimal(14, 2)
  negotiationFlexibility String?           // low | moderate | high
  preferredBuyerType   String?
  preferredTimeline    String?
  commissionType       String?             // percentage | fixed
  commissionPercent    Decimal?            @db.Decimal(5, 2)
  commissionFixed      Decimal?            @db.Decimal(12, 2)
  paymentStatus        String?
  internalNotes        String?             @db.Text

  ownerId              String
  owner                Owner               @relation(fields: [ownerId], references: [id])

  media                PropertyMedia[]
  enquiries            PropertyEnquiry[]
  activities           PropertyActivity[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  archivedAt           DateTime?

  @@index([status])
  @@index([propertyType])
  @@index([purpose])
  @@index([city, locality])
}

model PropertyMedia {
  id           String     @id @default(cuid())
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  url          String
  publicId     String     // Cloudinary asset id
  type         MediaType
  displayOrder Int        @default(0)
  isCover      Boolean    @default(false)

  createdAt    DateTime   @default(now())

  @@index([propertyId])
}

model PropertyEnquiry {
  id                 String        @id @default(cuid())
  propertyId         String
  property           Property      @relation(fields: [propertyId], references: [id])

  name               String
  phone              String
  whatsapp           String?
  email              String?
  message            String?       @db.Text
  preferredContactTime String?

  status             EnquiryStatus @default(NEW)
  privateNotes       String?       @db.Text // admin-only

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([propertyId])
  @@index([status])
}

model PropertyActivity {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  note        String   @db.Text
  createdAt   DateTime @default(now())

  @@index([propertyId])
}

model PropertySubmission {
  id              String            @id @default(cuid())
  name            String
  phone           String
  whatsapp        String?
  propertyType    PropertyType
  location        String
  approxArea      String?
  expectedPrice   String?
  description     String?           @db.Text
  status          SubmissionStatus  @default(PENDING_REVIEW)
  adminNotes      String?           @db.Text

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}
